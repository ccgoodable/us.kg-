# ============================================================
# DigitalPlat API Key 配置 (单账号或多账号)
# ============================================================

# 方式 1: 单账号 (向后兼容)
# DIGITALPLAT_API_KEY=dp_live_xxxxxxxxxxxxxxxxxxxxxxxx

# 方式 2: 多账号 (多行配置，支持备注名，格式为 "备注名:Key" 或纯 "Key")
# DIGITALPLAT_API_KEYS="
# 个人主号:dp_live_111111111111111111111111
# 工作备用:dp_live_222222222222222222222222
# "

# 方式 3: 多账号 (逗号或分号分隔)
# DIGITALPLAT_API_KEYS="主号:dp_live_111111111111111111111111,小号:dp_live_222222222222222222222222"

# 方式 4: JSON 数组配置
# DIGITALPLAT_ACCOUNTS='[{"name":"主号","apiKey":"dp_live_111111111111111111111111"},{"name":"小号","apiKey":"dp_live_222222222222222222222222"}]'

# ============================================================
# 运行策略参数 (通常保持默认即可)
# ============================================================
# DIGITALPLAT_BASE_URL=https://domain-api.digitalplat.org/api/v1
# RENEW_THRESHOLD_DAYS=120
# RENEW_YEARS=1
# RENEW_PAYMENT_FREE=free
# RENEW_PAYMENT_PAID=credits
# RENEW_DELAY_MS=300
# DRY_RUN=false
